{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "web-release",
      "displayName": "Azahar Web release",
      "description": "Configure with cmake --preset web-release after activating Emscripten 5.0.7",
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "binaryDir": "${sourceDir}/build/web-core",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_LIBRETRO": true,
        "ENABLE_LTO": true,
        "AZAHAR_ARM_JIT_STATISTICS": false,
        "AZAHAR_ARM_JIT_REGION_AFTER": "16384",
        "ENABLE_TESTS": true,
        "ENABLE_SOFTWARE_RENDERER": true,
        "ENABLE_OPENGL": false,
        "ENABLE_VULKAN": false,
        "ENABLE_NATIVE_OPTIMIZATION": false,
        "CITRA_USE_PRECOMPILED_HEADERS": false,
        "CITRA_WARNINGS_AS_ERRORS": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "web-qt",
      "displayName": "Azahar Web Qt frontend",
      "description": "Set AZAHAR_QT_SDK to the Qt Wasm SDK built with the pinned Qt Base and Qt Multimedia forks",
      "inherits": "web-release",
      "toolchainFile": "$env{AZAHAR_QT_SDK}/lib/cmake/Qt6/qt.toolchain.cmake",
      "binaryDir": "${sourceDir}/build/web-qt",
      "cacheVariables": {
        "ENABLE_LIBRETRO": false,
        "ENABLE_QT": true,
        "USE_SYSTEM_QT": true,
        "ENABLE_QT_TRANSLATION": false,
        "ENABLE_SDL2": false,
        "ENABLE_OPENAL": false,
        "ENABLE_CUBEB": false,
        "ENABLE_WEB_SERVICE": false,
        "ENABLE_SCRIPTING": false,
        "ENABLE_GDBSTUB": false,
        "ENABLE_ROOM": false,
        "ENABLE_ROOM_STANDALONE": false,
        "ENABLE_LIBUSB": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "web-release",
      "configurePreset": "web-release",
      "targets": ["azahar_libretro", "azahar_browser_runtime"]
    },
    {
      "name": "web-libretro",
      "configurePreset": "web-release",
      "targets": ["azahar_libretro"]
    },
    {
      "name": "web-qt",
      "configurePreset": "web-qt",
      "targets": ["azahar_qt_runtime"]
    },
    {
      "name": "web-native-fixtures",
      "configurePreset": "web-release",
      "targets": ["tests", "browser_core_fixtures"]
    }
  ],
  "testPresets": [
    {
      "name": "web-native-fixtures",
      "configurePreset": "web-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
