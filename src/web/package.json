{
  "name": "azahar-web-runtime",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "configure:runtime": "cmake -S ../.. --preset web-release",
    "build:runtime": "cmake --build ../../build/web-core --target azahar_browser_runtime",
    "serve:runtime": "emrun --no-browser --no-emrun-detect --hostname 127.0.0.1 ../../build/web-core/bin/Release/azahar.html",
    "build:core-fixtures": "cmake --build ../../build/web-core --target tests browser_core_fixtures",
    "test:core-fixtures": "ctest --test-dir ../../build/web-core --output-on-failure",
    "configure:fixtures": "cmake -S tests/upstream --preset web-native-fixtures",
    "build:fixtures": "cmake --build ../../build/web-fixtures --target upstream_fixtures",
    "test:fixtures": "ctest --test-dir ../../build/web-fixtures --output-on-failure"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@webgpu/types": "0.1.74",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "binaryen": "132.0.0"
  }
}
