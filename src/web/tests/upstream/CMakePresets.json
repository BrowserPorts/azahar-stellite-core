{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "web-native-fixtures",
      "displayName": "Azahar native fixtures in Wasm",
      "description": "Configure after activating Emscripten 5.0.7",
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "binaryDir": "${sourceDir}/../../../../build/web-fixtures",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_LTO": true,
        "AZAHAR_BUILD_UPSTREAM_FUZZ": true,
        "AZAHAR_ARM_JIT_REGION_AFTER": "1",
        "TEAKRA_TEST_ASSETS_DIR": "${sourceDir}/../../../../build/upstream-teakra"
      }
    },
    {
      "name": "web-arm-jit-threads",
      "displayName": "Dynarmic native fixtures with shared Wasm memory",
      "inherits": "web-native-fixtures",
      "binaryDir": "${sourceDir}/../../../../build/web-arm-jit-thread-fixtures",
      "cacheVariables": {
        "AZAHAR_ARM_JIT_THREADS": true
      }
    },
    {
      "name": "web-dsp-jit",
      "displayName": "Teakra native fixtures in the Wasm DSP JIT",
      "inherits": "web-native-fixtures",
      "binaryDir": "${sourceDir}/../../../../build/web-dsp-jit",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-msimd128",
        "AZAHAR_TEAKRA_JIT": true,
        "AZAHAR_TEAKRA_JIT_THREADS": false,
        "AZAHAR_DSP_JIT_OPTIMIZE_AFTER": "128"
      }
    },
    {
      "name": "web-dsp-jit-hot",
      "displayName": "Teakra native fixtures in the threaded hot Wasm DSP JIT",
      "inherits": "web-dsp-jit",
      "binaryDir": "${sourceDir}/../../../../build/web-dsp-jit-hot",
      "cacheVariables": {
        "AZAHAR_TEAKRA_JIT_THREADS": true,
        "AZAHAR_DSP_JIT_OPTIMIZE_AFTER": "1"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "web-native-fixtures",
      "configurePreset": "web-native-fixtures",
      "targets": ["upstream_fixtures"]
    },
    {
      "name": "web-arm-jit-threads",
      "configurePreset": "web-arm-jit-threads",
      "targets": ["browser_jit_fixtures"]
    },
    {
      "name": "web-dsp-jit",
      "configurePreset": "web-dsp-jit",
      "targets": ["teakra_reference_fixtures", "test_verifier"]
    },
    {
      "name": "web-dsp-jit-hot",
      "configurePreset": "web-dsp-jit-hot",
      "targets": ["teakra_reference_fixtures", "test_verifier"]
    }
  ],
  "testPresets": [
    {
      "name": "web-native-fixtures",
      "configurePreset": "web-native-fixtures",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "web-arm-jit-threads",
      "configurePreset": "web-arm-jit-threads",
      "filter": { "include": { "name": "^(dynarmic_(arm_jit_fixtures|arm_region_fixtures|arm_fuzz_fixtures::.*|vfp_recordings|vfp_region_recordings)|unicorn_arm_fixtures)$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 1500 }
    },
    {
      "name": "web-dsp-jit",
      "configurePreset": "web-dsp-jit",
      "filter": { "include": { "name": "^(teakra_reference_fixtures|tests)$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 1500 }
    },
    {
      "name": "web-dsp-jit-hot",
      "configurePreset": "web-dsp-jit-hot",
      "filter": { "include": { "name": "^(teakra_reference_fixtures|tests)$" } },
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 1500 }
    }
  ]
}
