function(azahar_pack_libretro target)
    set(PENDING ${target})
    set(VISITED)
    set(ARCHIVES)
    while(PENDING)
        list(POP_FRONT PENDING DEPENDENCY)
        if(DEPENDENCY MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE):([^<>]+)>$")
            set(DEPENDENCY "${CMAKE_MATCH_2}")
        endif()
        if(NOT TARGET "${DEPENDENCY}")
            continue()
        endif()
        get_target_property(ALIAS "${DEPENDENCY}" ALIASED_TARGET)
        if(ALIAS)
            set(DEPENDENCY "${ALIAS}")
        endif()
        if(DEPENDENCY IN_LIST VISITED)
            continue()
        endif()
        list(APPEND VISITED "${DEPENDENCY}")
        get_target_property(TYPE "${DEPENDENCY}" TYPE)
        if(TYPE STREQUAL "STATIC_LIBRARY")
            list(APPEND ARCHIVES "${DEPENDENCY}")
        endif()
        get_target_property(LINKS "${DEPENDENCY}" LINK_LIBRARIES)
        get_target_property(INTERFACES "${DEPENDENCY}" INTERFACE_LINK_LIBRARIES)
        if(LINKS)
            list(APPEND PENDING ${LINKS})
        endif()
        if(INTERFACES)
            list(APPEND PENDING ${INTERFACES})
        endif()
    endwhile()

    set(OUTPUT "${CMAKE_BINARY_DIR}/bin/$<CONFIG>/libretro_emscripten.a")
    set(MRI "CREATE \"${OUTPUT}.tmp\"\n")
    foreach(ARCHIVE IN LISTS ARCHIVES)
        string(APPEND MRI "ADDLIB \"$<TARGET_FILE:${ARCHIVE}>\"\n")
    endforeach()
    string(APPEND MRI "SAVE\nEND\n")
    set(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/libretro-$<CONFIG>.mri")
    file(GENERATE OUTPUT "${SCRIPT}" CONTENT "${MRI}")
    add_custom_command(OUTPUT "${OUTPUT}"
        COMMAND "${CMAKE_COMMAND}" "-DAR=${CMAKE_AR}" "-DINPUT=${SCRIPT}" "-DOUTPUT=${OUTPUT}"
            -P "${PROJECT_SOURCE_DIR}/src/web/libretro/merge-archive.cmake"
        DEPENDS ${ARCHIVES} "${SCRIPT}" "${PROJECT_SOURCE_DIR}/src/web/libretro/merge-archive.cmake"
        VERBATIM)
    add_custom_target(azahar_libretro_wasm DEPENDS "${OUTPUT}")
endfunction()
